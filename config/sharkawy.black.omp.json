{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .Folder }} · PowerShell",
  "secondary_prompt": {
    "template": "\uf101 ",
    "foreground": "#A0A0A0",
    "background": "transparent"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#D8DCE3",
          "template": "{{ if eq .Path \"~\" }}\uf015  <b>Home</b>{{ else }}\uf07c  <b>{{ .Path }}</b>{{ end }}",
          "properties": {
            "style": "folder",
            "folder_separator_icon": "/",
            "folder_icon": "…",
            "home_icon": "~"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#BBC4D2",
          "template": "   {{ .HEAD }}{{ if .Working.Changed }}  <#E6BD87>\uf044 {{ add .Working.Added .Working.Modified .Working.Deleted .Working.Untracked .Working.Unmerged }}</>{{ end }}{{ if .Staging.Changed }}  <#D8DCE3>\uf046 {{ add .Staging.Added .Staging.Modified .Staging.Deleted .Staging.Untracked .Staging.Unmerged }}</>{{ end }}{{ if gt .Ahead 0 }}  \uf062 {{ .Ahead }}{{ end }}{{ if gt .Behind 0 }}  \uf063 {{ .Behind }}{{ end }}{{ if gt .StashCount 0 }}  <#A0A0A0>\uf187 {{ .StashCount }}</>{{ end }}",
          "properties": {
            "branch_icon": "\ue0a0 ",
            "fetch_status": true,
            "fetch_stash_count": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#E6BD87",
          "template": "\uf0e7 {{ .FormattedMs }}    ",
          "properties": {
            "threshold": 0,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#A0A0A0",
          "template": "\uf017 {{ .CurrentDate | date .Format }}",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#D8DCE3",
          "foreground_templates": ["{{ if ne .Code 0 }}#ED9B91{{ end }}"],
          "template": "\uf105",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
